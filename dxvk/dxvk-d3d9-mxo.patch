+
+
+  Rc<DxvkShader> D3D9CommonShader::GetStaticSamplerVariant(
+          D3D9DeviceEx*         pDevice,
+          D3D9ShaderPermutation Permutation,
+          uint32_t              Types,
+          uint32_t              Depth) const {
+    if ((!Types && !Depth) || m_variants == nullptr)
+      return m_shaders[Permutation];
+
+    const uint64_t variantKey = uint64_t(Types) | (uint64_t(Depth) << 32);
+
+    std::lock_guard<dxvk::mutex> lock(m_variants->mutex);
+
+    auto entry = m_variants->shaders.find(variantKey);
+
+    if (entry == m_variants->shaders.end()) {
+      DxsoReader reader(reinterpret_cast<const char*>(m_bytecode.data()));
+      DxsoModule module(reader);
+
+      DxsoAnalysisInfo analysis = module.analyze();
+
+      DxsoModuleInfo moduleInfo = m_moduleInfo;
+      moduleInfo.options.staticSamplerTypes = Types;
+      moduleInfo.options.staticSamplerDepth = Depth;
+
+      // Give the variant its own identity for the pipeline and state caches
+      std::array<uint32_t, 7> keyData = {{
+        m_key.sha1().dword(0), m_key.sha1().dword(1), m_key.sha1().dword(2),
+        m_key.sha1().dword(3), m_key.sha1().dword(4), Types, Depth }};
+
+      DxvkShaderKey key(m_stage, Sha1Hash::compute(keyData.data(), sizeof(keyData)));
+
+      const D3D9ConstantLayout& constantLayout = m_stage == VK_SHADER_STAGE_VERTEX_BIT
+        ? pDevice->GetVertexConstantLayout()
+        : pDevice->GetPixelConstantLayout();
+
