--- a/src/dxvk/dxvk_debug_counters.h	1970-01-01 01:00:00
+++ b/src/dxvk/dxvk_debug_counters.h	2026-11-16 20:41:13
@@ -0,0 +1,48 @@
+#pragma once
+
+// Diagnostic counters read by the D3D9 front end's optional frame log (C:\Games\dxvk\debug.flag).
+// Written from the rendering threads without locking; the values are statistics, not state.
+
+#include <atomic>
+#include <cstdint>
+
+namespace dxvk {
+
+  /// Where render passes get interrupted: callers of DxvkContext::spillRenderPass that found a pass open
+  struct DxvkSpillStats {
+    static constexpr uint32_t Max = 24;
+
+    static inline std::atomic<uintptr_t> s_caller[Max] = { };
+    static inline std::atomic<uint32_t>  s_count[Max]  = { };
+
+    static void add(void* caller) {
+      const uintptr_t address = reinterpret_cast<uintptr_t>(caller);
+
+      for (uint32_t i = 0; i < Max; i++) {
+        uintptr_t current = s_caller[i].load();
+
+        if (!current) {
+          s_caller[i].compare_exchange_strong(current, address);
+          current = s_caller[i].load();
+        }
+
+        if (current == address) {
+          s_count[i]++;
+          return;
+        }
+      }
+    }
+  };
+
+  /// Calls the application made, per kind
+  enum class DxvkDebugCounter : uint32_t {
+    SetRenderTarget, Clear, EndScene, StretchRect, TextureLock, TextureUpload, BufferUpload, BufferRename,
+    ColorFill, GetRenderTargetData, Count
+  };
+
+  struct DxvkDebugCounters {
+    static inline std::atomic<uint32_t> s_value[uint32_t(DxvkDebugCounter::Count)] = { };
+    static void add(DxvkDebugCounter c) { s_value[uint32_t(c)]++; }
+  };
+
+}
