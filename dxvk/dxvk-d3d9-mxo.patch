+      if (shaders[1] != nullptr) {
+        shaders[1]->setShaderKey({ VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT, key.sha1() });
+        pDevice->GetDXVKDevice()->registerShader(shaders[1]);
+      }
