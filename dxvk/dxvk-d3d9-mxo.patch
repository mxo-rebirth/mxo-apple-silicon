diff --color -ruN --exclude=build.w32 --exclude=*.orig --exclude=*.log --exclude=d3d9_mxo_x87.inc --exclude=.DS_Store a/src/d3d9/d3d9_mxo_fastmath.cpp b/src/d3d9/d3d9_mxo_fastmath.cpp
--- a/src/d3d9/d3d9_mxo_fastmath.cpp	1970-01-01 01:00:00
+++ b/src/d3d9/d3d9_mxo_fastmath.cpp	2026-11-16 21:18:18
@@ -0,0 +1,321 @@
+#include <windows.h>
+#include <tlhelp32.h>
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+#include "../util/log/log.h"
+#include "../util/util_env.h"
+#include "../util/util_string.h"
+
+#include "d3d9_mxo_fastmath.h"
+
+#include "d3d9_mxo_fastmath_asm.inc"
+
+// x87 routines of the client translated to SSE2 by xlat.py
+#include "d3d9_mxo_x87.h"
+#include "d3d9_mxo_x87.inc"
+
+extern "C" {
+  extern uint32_t MxoX_funcs[], MxoX_absfix[], MxoX_relfix[], MxoX_deps[];
+  extern uint8_t  MxoX_code_begin[], MxoX_code_end[];
+  extern uint32_t MxoX_tid, MxoX_imagebase;
+}
+
+namespace dxvk {
+
+  static uint32_t s_x87Thread = 0;
+
+  static bool RedirectFunction(uint8_t* target, void* replacement) {
+    DWORD oldProtect = 0;
+
+    if (!::VirtualProtect(target, 5, PAGE_EXECUTE_READWRITE, &oldProtect))
+      return false;
+
+    const int32_t rel = int32_t(intptr_t(replacement) - intptr_t(target + 5));
+    target[0] = 0xE9; // jmp rel32
+    std::memcpy(target + 1, &rel, sizeof(rel));
+
+    ::VirtualProtect(target, 5, oldProtect, &oldProtect);
+    ::FlushInstructionCache(::GetCurrentProcess(), target, 5);
+    return true;
+  }
+
+
+  // Writes the entry jumps of all given routines while every other thread of the process is
+  // suspended, and leaves out any routine a thread is just entering. Nothing in the suspended
+  // section allocates or takes locks.
+  static uint32_t InstallRedirects(uint8_t* base, const std::vector<const MxoXFunc*>& funcs) {
+    std::vector<DWORD> oldProtect(funcs.size(), 0);
+    std::vector<uint8_t> writable(funcs.size(), 0);
+
+    for (size_t i = 0; i < funcs.size(); i++)
+      writable[i] = ::VirtualProtect(base + funcs[i]->rva, 5, PAGE_EXECUTE_READWRITE, &oldProtect[i]) ? 1 : 0;
+
+    std::vector<HANDLE> threads;
+    HANDLE snapshot = ::CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+
+    if (snapshot != INVALID_HANDLE_VALUE) {
+      THREADENTRY32 entry = { };
+      entry.dwSize = sizeof(entry);
+
+      for (BOOL more = ::Thread32First(snapshot, &entry); more; more = ::Thread32Next(snapshot, &entry)) {
+        if (entry.th32OwnerProcessID != ::GetCurrentProcessId() || entry.th32ThreadID == ::GetCurrentThreadId())
+          continue;
+
+        if (HANDLE thread = ::OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT, FALSE, entry.th32ThreadID))
+          threads.push_back(thread);
+      }
+
+      ::CloseHandle(snapshot);
+    }
+
+    std::vector<uint32_t> eips(threads.size(), 0);
+    uint32_t installed = 0;
+
+    // ---- no allocation, logging or locking from here ...
+    for (size_t t = 0; t < threads.size(); t++) {
+      if (::SuspendThread(threads[t]) == DWORD(-1))
+        continue;
+
+      CONTEXT context;
+      context.ContextFlags = CONTEXT_CONTROL;
+
+      if (::GetThreadContext(threads[t], &context))
+        eips[t] = uint32_t(context.Eip);
+    }
+
+    for (size_t i = 0; i < funcs.size(); i++) {
+      if (!writable[i])
+        continue;
+
+      uint8_t* target = base + funcs[i]->rva;
+      const uint32_t address = uint32_t(uintptr_t(target));
+      bool busy = false;
+
+      for (size_t t = 0; t < eips.size() && !busy; t++)
+        busy = eips[t] > address && eips[t] < address + 5;
+
+      if (busy)
+        continue;
+
+      const int32_t rel = int32_t(intptr_t(funcs[i]->replacement) - intptr_t(target + 5));
+      target[0] = 0xE9; // jmp rel32
+      std::memcpy(target + 1, &rel, sizeof(rel));
+      installed++;
+    }
+
+    for (size_t t = 0; t < threads.size(); t++)
+      ::ResumeThread(threads[t]);
+    // ---- ... to here
+
+    for (HANDLE thread : threads)
+      ::CloseHandle(thread);
+
+    for (size_t i = 0; i < funcs.size(); i++) {
+      if (writable[i]) {
+        DWORD ignored = 0;
+        ::VirtualProtect(base + funcs[i]->rva, 5, oldProtect[i], &ignored);
+        ::FlushInstructionCache(::GetCurrentProcess(), base + funcs[i]->rva, 5);
+      }
+    }
+
+    return installed;
+  }
+
+
+  void ApplyMxoFastMath() {
+    static std::atomic<bool> s_done = { false };
+
+    if (s_done.exchange(true))
+      return;
+
+    if (env::getEnvVar("DXVK_MXO_FASTMATH") == "0")
+      return;
+
+    HMODULE client = ::GetModuleHandleA("client.dll");
+
+    if (!client)
+      return;
+
+    auto base = reinterpret_cast<uint8_t*>(client);
+    auto dos  = reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
+
+    if (dos->e_magic != IMAGE_DOS_SIGNATURE)
+      return;
+
+    auto nt = reinterpret_cast<const IMAGE_NT_HEADERS32*>(base + dos->e_lfanew);
+
+    if (nt->Signature != IMAGE_NT_SIGNATURE)
+      return;
+
+    const uint32_t imageSize = nt->OptionalHeader.SizeOfImage;
+
+    // Two hand-written replacements. The originals are recognised by position, length and a hash of
+    // their code (address fields excluded), so no game code is carried in this file.
+    struct HandWritten {
+      uint32_t    rva;
+      uint32_t    size;
+      uint64_t    hash;
+      uint32_t    refCount;       // address fields inside the routine; each must point at the float 1.0
+      uint32_t    refs[3];
+      void*       replacement;
+    };
+
+    const HandWritten handWritten[2] = {
+      { 0x45e10, 554, 0xb89ece1419908b6bull, 0, { 0, 0, 0 },       reinterpret_cast<void*>(&MxoMatMulSSE)    },
+      { 0x46510, 214, 0x4b661a4a028dab20ull, 3, { 118, 159, 201 }, reinterpret_cast<void*>(&MxoQuatToMatSSE) },
+    };
+
+    bool replaced[2] = { false, false };
+
+    for (uint32_t r = 0; r < 2; r++) {
+      const HandWritten& h = handWritten[r];
+
+      if (h.rva > imageSize || h.size > imageSize - h.rva)
+        continue;
+
+      const uint8_t* code = base + h.rva;
+      uint64_t hash = 0xcbf29ce484222325ull;   // FNV-1a
+      bool same = true;
+
+      for (uint32_t i = 0; i < h.size; ) {
+        bool isRef = false;
+
+        for (uint32_t k = 0; k < h.refCount; k++)
+          isRef = isRef || h.refs[k] == i;
+
+        if (isRef) {
+          uint32_t address;
+          std::memcpy(&address, code + i, sizeof(address));
+
+          const uint32_t imageBase = uint32_t(uintptr_t(base));
+          float one = 0.0f;
+
+          if (address >= imageBase && address <= imageBase + imageSize - sizeof(float))
+            std::memcpy(&one, reinterpret_cast<const void*>(uintptr_t(address)), sizeof(one));
+
+          same = same && one == 1.0f;
+          i += 4;
+        } else {
+          hash = (hash ^ code[i]) * 0x100000001b3ull;
+          i += 1;
+        }
+      }
+
+      replaced[r] = same && hash == h.hash && RedirectFunction(base + h.rva, h.replacement);
+    }
+
+    Logger::info(str::format("MxO fast math: matrix multiply ", replaced[0] ? "replaced" : "left alone",
+      ", quaternion to matrix ", replaced[1] ? "replaced" : "left alone"));
+
+    if (env::getEnvVar("DXVK_MXO_X87") == "0")
+      return;
+
+    // Translated routines. They assume the FPU setup of the thread that owns the device (24-bit
+    // precision, round to nearest) and send every other thread back into the original code.
+    // C:\Games\dxvk\x87max.txt may hold a number to install only the first N (for bisecting).
+    uint32_t limit = ~0u;
+
+    if (FILE* file = std::fopen("C:\\Games\\dxvk\\x87max.txt", "r")) {
+      if (std::fscanf(file, "%u", &limit) != 1)
+        limit = ~0u;
+      std::fclose(file);
+    }
+
+    uint32_t total = 0, matching = 0, installed = 0;
+
+    if (MxoXFixups(base, MxoX_imagebase, MxoX_absfix, MxoX_relfix, MxoX_code_begin, MxoX_code_end)) {
+      s_x87Thread = ::GetCurrentThreadId();
+      MxoX_tid    = s_x87Thread;
+
+      // code the translations rely on without replacing it
+      bool depsIntact = true;
+
+      for (auto f = reinterpret_cast<const MxoXFunc*>(MxoX_deps); f->size; f++)
+        depsIntact = depsIntact && MxoXMatches(base, imageSize, MxoX_imagebase, *f);
+
+      std::vector<const MxoXFunc*> todo;
+      std::string differing;
+
+      for (auto f = reinterpret_cast<const MxoXFunc*>(MxoX_funcs); f->size; f++) {
+        if (total++ >= limit)
+          continue;
+
+        if ((f->flags & 1) && !depsIntact)
+          continue;
+
+        if (MxoXMatches(base, imageSize, MxoX_imagebase, *f))
+          todo.push_back(f);
+        else if (differing.size() < 80)
+          differing += str::format(" ", std::hex, f->rva);
+      }
+
+      matching  = uint32_t(todo.size());
+      installed = InstallRedirects(base, todo);
+
+      if (!differing.empty())
+        Logger::info(str::format("MxO fast math: left alone because the code in memory differs (rva):", differing));
+    }
+
+    Logger::info(str::format("MxO fast math: ", installed, " of ", total, " translated x87 routines installed (",
+      matching, " match this client.dll)"));
+  }
+
+
+  float GetMxoRenderThrottle() {
+    // The client keeps its render throttle (1 = full draw distance, down to 0.25) at [[client+0x9f84e8]+0x14].
+    // Only trusted if the throttle routine at client+0x28e0 really loads that pointer where expected.
+    static const uint8_t* s_client = [] () -> const uint8_t* {
+      auto base = reinterpret_cast<const uint8_t*>(::GetModuleHandleA("client.dll"));
+
+      if (!base)
+        return nullptr;
+
+      auto nt = reinterpret_cast<const IMAGE_NT_HEADERS32*>(base + reinterpret_cast<const IMAGE_DOS_HEADER*>(base)->e_lfanew);
+
+      if (nt->OptionalHeader.SizeOfImage < 0xa00000)
+        return nullptr;
+
+      const uint32_t global = uint32_t(uintptr_t(base)) + 0x9f84e8;
+      uint64_t hash = 0xcbf29ce484222325ull;   // FNV-1a of the store's code around its address, which has to name the global
+      for (uint32_t i : { 0u, 1u, 6u, 7u, 8u }) hash = (hash ^ base[0x2900 + i]) * 0x100000001b3ull;
+      return hash != 0xb7258c7ae11ecf31ull || std::memcmp(base + 0x2900 + 2, &global, 4) ? nullptr : base;
+    }();
+
+    if (!s_client)
+      return -1.0f;
+
+    uint32_t object = 0;
+    std::memcpy(&object, s_client + 0x9f84e8, 4);
+
+    if (!object)
+      return -1.0f;
+
+    float throttle = -1.0f;
+    std::memcpy(&throttle, reinterpret_cast<const void*>(uintptr_t(object + 0x14)), 4);
+    return throttle;
+  }
+
+
+  void CheckMxoFastMathFpu() {
+    if (!s_x87Thread || ::GetCurrentThreadId() != s_x87Thread)
+      return;
+
+    // precision control (bits 8-9) must be 24-bit and rounding control (bits 10-11) nearest
+    uint16_t control = 0;
+    __asm__ __volatile__("fnstcw %0" : "=m" (*&control));
+
+    const bool usable = !(control & 0x0f00);
+
+    if (usable != (MxoX_tid != 0)) {
+      MxoX_tid = usable ? s_x87Thread : 0;
+      Logger::warn(str::format("MxO fast math: FPU control word ", std::hex, control,
+        usable ? ", translated routines back on" : ", translated routines off"));
+    }
+  }
+
+}
diff --color -ruN --exclude=build.w32 --exclude=*.orig --exclude=*.log --exclude=d3d9_mxo_x87.inc --exclude=.DS_Store a/src/d3d9/d3d9_mxo_fastmath.h b/src/d3d9/d3d9_mxo_fastmath.h
--- a/src/d3d9/d3d9_mxo_fastmath.h	1970-01-01 01:00:00
+++ b/src/d3d9/d3d9_mxo_fastmath.h	2026-11-16 19:21:35
@@ -0,0 +1,32 @@
+#pragma once
+
+namespace dxvk {
+
+  /**
+   * \brief Faster math routines for The Matrix Online
+   *
+   * The game's client.dll does its vector and matrix math on the x87 FPU, which
+   * Rosetta 2 emulates in software. If the loaded client.dll contains two specific,
+   * byte-identical hot routines (4x4 matrix multiply, quaternion to matrix), they
+   * are redirected in memory to SSE implementations. Nothing on disk is changed
+   * and other programs are not affected. Set DXVK_MXO_FASTMATH=0 to disable.
+   *
+   * A further set of the client's hot x87 routines is replaced by SSE2 code that
+   * xlat.py generated from them (d3d9_mxo_x87.inc); each is installed only if the
+   * loaded client.dll holds exactly the code it was generated from. Set
+   * DXVK_MXO_X87=0 to disable just those.
+   */
+  void ApplyMxoFastMath();
+
+  /**
+   * \brief Checks once per frame that the FPU is still set up the way the
+   *        translated routines assume, and switches them off otherwise
+   */
+  void CheckMxoFastMathFpu();
+
+  /**
+   * \brief The game's current render throttle (1 = full draw distance), or -1 if unknown
+   */
+  float GetMxoRenderThrottle();
+
+}
diff --color -ruN --exclude=build.w32 --exclude=*.orig --exclude=*.log --exclude=d3d9_mxo_x87.inc --exclude=.DS_Store a/src/d3d9/d3d9_mxo_fastmath_asm.inc b/src/d3d9/d3d9_mxo_fastmath_asm.inc
--- a/src/d3d9/d3d9_mxo_fastmath_asm.inc	1970-01-01 01:00:00
+++ b/src/d3d9/d3d9_mxo_fastmath_asm.inc	2026-11-16 15:36:05
@@ -0,0 +1,81 @@
+// SSE replacements for two x87 math routines of The Matrix Online client (see d3d9_mxo_fastmath.cpp).
+//
+// MxoMatMulSSE      thiscall  Matrix4* Matrix4::Multiply(Matrix4* out, const Matrix4* b)   out = this * b
+// MxoQuatToMatSSE   thiscall  void     Matrix::FromQuaternion(const float q[4])            rotation part of this
+//
+// Both compute everything before writing the result, like the originals, so out may alias the inputs.
+#define MXO_ROW(off) \
+  "movss  xmm0, dword ptr [ecx+" #off "]\n"      "shufps xmm0, xmm0, 0\n" "mulps xmm0, xmm4\n" \
+  "movss  xmm1, dword ptr [ecx+" #off "+4]\n"    "shufps xmm1, xmm1, 0\n" "mulps xmm1, xmm5\n" "addps xmm0, xmm1\n" \
+  "movss  xmm1, dword ptr [ecx+" #off "+8]\n"    "shufps xmm1, xmm1, 0\n" "mulps xmm1, xmm6\n" "addps xmm0, xmm1\n" \
+  "movss  xmm1, dword ptr [ecx+" #off "+12]\n"   "shufps xmm1, xmm1, 0\n" "mulps xmm1, xmm7\n" "addps xmm0, xmm1\n" \
+  "movups xmmword ptr [esp+" #off "], xmm0\n"
+
+__asm__(
+  ".intel_syntax noprefix\n"
+  ".text\n"
+  ".p2align 4\n"
+  ".globl _MxoMatMulSSE\n"
+  "_MxoMatMulSSE:\n"
+  "mov    eax, dword ptr [esp+8]\n"          // b
+  "mov    edx, dword ptr [esp+4]\n"          // out
+  "sub    esp, 64\n"
+  "movups xmm4, xmmword ptr [eax]\n"
+  "movups xmm5, xmmword ptr [eax+16]\n"
+  "movups xmm6, xmmword ptr [eax+32]\n"
+  "movups xmm7, xmmword ptr [eax+48]\n"
+  MXO_ROW(0)
+  MXO_ROW(16)
+  MXO_ROW(32)
+  MXO_ROW(48)
+  "movups xmm0, xmmword ptr [esp]\n"
+  "movups xmm1, xmmword ptr [esp+16]\n"
+  "movups xmm2, xmmword ptr [esp+32]\n"
+  "movups xmm3, xmmword ptr [esp+48]\n"
+  "movups xmmword ptr [edx], xmm0\n"
+  "movups xmmword ptr [edx+16], xmm1\n"
+  "movups xmmword ptr [edx+32], xmm2\n"
+  "movups xmmword ptr [edx+48], xmm3\n"
+  "add    esp, 64\n"
+  "mov    eax, edx\n"
+  "ret    8\n"
+
+  ".p2align 4\n"
+  ".globl _MxoQuatToMatSSE\n"
+  "_MxoQuatToMatSSE:\n"
+  "mov    eax, dword ptr [esp+4]\n"          // q = { x, y, z, w }
+  "sub    esp, 40\n"
+  "mov    dword ptr [esp+36], 0x3f800000\n"  // 1.0f
+  "movss  xmm0, dword ptr [eax]\n"           // x
+  "movss  xmm1, dword ptr [eax+4]\n"         // y
+  "movss  xmm2, dword ptr [eax+8]\n"         // z
+  "movss  xmm3, dword ptr [eax+12]\n"        // w
+  "movaps xmm4, xmm0\n" "addss xmm4, xmm4\n" // x2
+  "movaps xmm5, xmm1\n" "addss xmm5, xmm5\n" // y2
+  "movaps xmm6, xmm2\n" "addss xmm6, xmm6\n" // z2
+  "movaps xmm7, xmm4\n" "mulss xmm7, xmm3\n" "movss dword ptr [esp],    xmm7\n"   // wx
+  "movaps xmm7, xmm5\n" "mulss xmm7, xmm3\n" "movss dword ptr [esp+4],  xmm7\n"   // wy
+  "movaps xmm7, xmm6\n" "mulss xmm7, xmm3\n" "movss dword ptr [esp+8],  xmm7\n"   // wz
+  "movaps xmm7, xmm4\n" "mulss xmm7, xmm0\n" "movss dword ptr [esp+12], xmm7\n"   // xx
+  "movaps xmm7, xmm5\n" "mulss xmm7, xmm0\n" "movss dword ptr [esp+16], xmm7\n"   // xy
+  "movaps xmm7, xmm6\n" "mulss xmm7, xmm0\n" "movss dword ptr [esp+20], xmm7\n"   // xz
+  "movaps xmm7, xmm5\n" "mulss xmm7, xmm1\n" "movss dword ptr [esp+24], xmm7\n"   // yy
+  "movaps xmm7, xmm6\n" "mulss xmm7, xmm1\n" "movss dword ptr [esp+28], xmm7\n"   // yz
+  "mulss  xmm6, xmm2\n"                      "movss dword ptr [esp+32], xmm6\n"   // zz
+  "movss  xmm7, dword ptr [esp+36]\n"        // 1.0
+  "movss  xmm0, dword ptr [esp+32]\n" "addss xmm0, dword ptr [esp+24]\n" "movaps xmm1, xmm7\n" "subss xmm1, xmm0\n" "movss dword ptr [ecx],      xmm1\n"  // 1 - (zz + yy)
+  "movss  xmm0, dword ptr [esp+16]\n" "addss xmm0, dword ptr [esp+8]\n"                                             "movss dword ptr [ecx+4],    xmm0\n"  // xy + wz
+  "movss  xmm0, dword ptr [esp+20]\n" "subss xmm0, dword ptr [esp+4]\n"                                             "movss dword ptr [ecx+8],    xmm0\n"  // xz - wy
+  "movss  xmm0, dword ptr [esp+16]\n" "subss xmm0, dword ptr [esp+8]\n"                                             "movss dword ptr [ecx+0x10], xmm0\n"  // xy - wz
+  "movss  xmm0, dword ptr [esp+32]\n" "addss xmm0, dword ptr [esp+12]\n" "movaps xmm1, xmm7\n" "subss xmm1, xmm0\n" "movss dword ptr [ecx+0x14], xmm1\n"  // 1 - (zz + xx)
+  "movss  xmm0, dword ptr [esp+28]\n" "addss xmm0, dword ptr [esp]\n"                                               "movss dword ptr [ecx+0x18], xmm0\n"  // yz + wx
+  "movss  xmm0, dword ptr [esp+20]\n" "addss xmm0, dword ptr [esp+4]\n"                                             "movss dword ptr [ecx+0x20], xmm0\n"  // xz + wy
+  "movss  xmm0, dword ptr [esp+28]\n" "subss xmm0, dword ptr [esp]\n"                                               "movss dword ptr [ecx+0x24], xmm0\n"  // yz - wx
+  "movss  xmm0, dword ptr [esp+24]\n" "addss xmm0, dword ptr [esp+12]\n" "movaps xmm1, xmm7\n" "subss xmm1, xmm0\n" "movss dword ptr [ecx+0x28], xmm1\n"  // 1 - (yy + xx)
+  "add    esp, 40\n"
+  "ret    4\n"
+  ".att_syntax prefix\n"
+);
+
+extern "C" void MxoMatMulSSE();
+extern "C" void MxoQuatToMatSSE();
diff --color -ruN --exclude=build.w32 --exclude=*.orig --exclude=*.log --exclude=d3d9_mxo_x87.inc --exclude=.DS_Store a/src/d3d9/d3d9_mxo_x87.h b/src/d3d9/d3d9_mxo_x87.h
--- a/src/d3d9/d3d9_mxo_x87.h	1970-01-01 01:00:00
+++ b/src/d3d9/d3d9_mxo_x87.h	2026-11-16 19:15:37
@@ -0,0 +1,71 @@
+// Runtime side of the x87 -> SSE2 translations generated by xlat.py.
+#pragma once
+
+#include <windows.h>
+#include <cstdint>
+#include <cstring>
+
+struct MxoXFunc {
+  uint32_t        rva;          // function start in the image
+  uint32_t        size;         // length of the original code
+  void*           replacement;  // translated code
+  const uint8_t*  orig;         // original bytes, as linked at the preferred base
+  const uint32_t* relocs;       // ascending offsets of relocated dwords, ends with 0xffffffff
+  uint32_t        flags;        // 1: relies on every entry of the dependency table being intact
+};
+
+// Points the translated code at an image loaded at 'base'. Call once.
+static inline bool MxoXFixups(const uint8_t* base, uint32_t prefBase, const uint32_t* absfix,
+                              const uint32_t* relfix, uint8_t* codeBegin, uint8_t* codeEnd) {
+  DWORD oldProtect = 0;
+
+  if (!::VirtualProtect(codeBegin, codeEnd - codeBegin, PAGE_EXECUTE_READWRITE, &oldProtect))
+    return false;
+
+  const uint32_t imageBase = uint32_t(uintptr_t(base));
+  const uint32_t delta = imageBase - prefBase;
+
+  for (const uint32_t* p = absfix; *p; p++) {
+    uint32_t value;
+    std::memcpy(&value, reinterpret_cast<void*>(uintptr_t(*p)), 4);
+    value += delta;
+    std::memcpy(reinterpret_cast<void*>(uintptr_t(*p)), &value, 4);
+  }
+
+  for (const uint32_t* p = relfix; p[0]; p += 2) {
+    const int32_t rel = int32_t(imageBase + p[1] - (p[0] + 4));
+    std::memcpy(reinterpret_cast<void*>(uintptr_t(p[0])), &rel, 4);
+  }
+
+  ::VirtualProtect(codeBegin, codeEnd - codeBegin, oldProtect, &oldProtect);
+  ::FlushInstructionCache(::GetCurrentProcess(), codeBegin, codeEnd - codeBegin);
+  return true;
+}
+
+// True if the image loaded at 'base' holds exactly the code the translation was made from.
+static inline bool MxoXMatches(const uint8_t* base, uint32_t imageSize, uint32_t prefBase, const MxoXFunc& f) {
+  if (f.rva > imageSize || f.size > imageSize - f.rva)
+    return false;
+
+  const uint32_t delta = uint32_t(uintptr_t(base)) - prefBase;
+  const uint8_t* code = base + f.rva;
+  const uint32_t* reloc = f.relocs;
+
+  for (uint32_t i = 0; i < f.size; ) {
+    if (*reloc == i) {
+      uint32_t a, b;
+      std::memcpy(&a, code + i, 4);
+      std::memcpy(&b, f.orig + i, 4);
+      if (a != b + delta)
+        return false;
+      i += 4;
+      reloc++;
+    } else {
+      if (code[i] != f.orig[i])
+        return false;
+      i++;
+    }
+  }
+
+  return true;
+}
