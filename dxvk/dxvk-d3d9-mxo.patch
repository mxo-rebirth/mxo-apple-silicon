+               || entry.th32ThreadID == s_presentThreadId)
+                continue;
+              if (HANDLE other = ::OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT, FALSE, entry.th32ThreadID)) {
+                Sample os;
+                if (takeSample(other, os))
+                  others.push_back({ entry.th32ThreadID, os });
+                ::CloseHandle(other);
+              }
+            }
+            ::CloseHandle(snapshot);
+          }
+        }
+      } else if (!samples.empty()) {
+        // the stall is over: names are resolved now, with the game thread running again
+        std::unordered_map<std::string, uint32_t> counts;
+        for (const auto& s : samples) {
+          std::string key = DescribeAddress(s.eip);
+          for (uint32_t r : s.ret)
+            if (r) key += " < " + DescribeAddress(r);
+          counts[key]++;
+        }
+        std::vector<std::pair<uint32_t, std::string>> sorted;
+        for (auto& c : counts)
+          sorted.push_back({ c.second, c.first });
+        std::sort(sorted.begin(), sorted.end(), [] (const auto& a, const auto& b) { return a.first > b.first; });
+        std::string text = str::format("STALL ", last - stallBegan, " ms, ", samples.size(), " samples",
+          samples.size() >= MaxStallSamples
+            ? str::format(" (of its first ", MaxStallSampledMs / 1000, " seconds); ")
+            : std::string("; "),
+          focusAtStart, "; at the end: ", describeFocus());
+        for (size_t i = 0; i < sorted.size() && i < StallListedPlaces; i++)
+          text += str::format("\n    ", sorted[i].first, "x  ", sorted[i].second);
+        // other threads that were not simply waiting in ntdll
+        std::unordered_map<std::string, uint32_t> otherCounts;
+        for (const auto& o : others) {
+          const std::string at = DescribeAddress(o.second.eip);
+          if (at.rfind("ntdll.dll+", 0) == 0 || at.rfind("win32u.dll+", 0) == 0)
+            continue;
+          std::string key = str::format("thread ", o.first, ": ", at);
+          for (uint32_t r : o.second.ret)
+            if (r) key += " < " + DescribeAddress(r);
+          otherCounts[key]++;
+        }
+        std::vector<std::pair<uint32_t, std::string>> otherSorted;
+        for (auto& c : otherCounts)
+          otherSorted.push_back({ c.second, c.first });
+        std::sort(otherSorted.begin(), otherSorted.end(), [] (const auto& a, const auto& b) { return a.first > b.first; });
+        for (size_t i = 0; i < otherSorted.size() && i < StallListedOtherPlaces; i++)
+          text += str::format("\n    other ", otherSorted[i].first, "x  ", otherSorted[i].second);
+        Logger::info(text);
+
+        if (++logged == MaxLoggedStalls) {
+          Logger::info(str::format("STALL lines end here, ", MaxLoggedStalls, " are logged"));
+          ::CloseHandle(thread);
+          return 0;
+        }
+
+        samples.clear();
+        others.clear();
+        stallTicks = 0;
+      }
+    }
+  }
+
+  static void SamplerMarker() { }
+
+  // True if the diagnostics folder holds a file of this name
+  static bool HasDiagnosticsFile(const char* fileName) {
+    return ::GetFileAttributesA(GetMxoDiagnosticsPath(fileName).c_str()) != INVALID_FILE_ATTRIBUTES;
+  }
+
+  // A request file asks for something once: true if it is there, and then it is deleted
+  static bool TakeDiagnosticsRequest(const char* fileName) {
+    const std::string path = GetMxoDiagnosticsPath(fileName);
+
+    if (::GetFileAttributesA(path.c_str()) == INVALID_FILE_ATTRIBUTES)
+      return false;
+
+    ::DeleteFileA(path.c_str());
+    return true;
+  }
+
+  static DWORD WINAPI SamplerThreadProc(void*) {
+    static constexpr uint32_t MaxSamples       = 60000;   // per write to the file
+    static constexpr uint32_t MaxThreads       = 64;
+    static constexpr DWORD    IntervalMs       = 5;
+    static constexpr DWORD    LightIntervalMs  = 20;
+    static constexpr DWORD    ScanIntervalMs   = 2000;    // for new threads and modules
+    static constexpr DWORD    WriteIntervalMs  = 10000;
+    static constexpr uint32_t StackWords       = 192;     // how far up the stack return addresses are looked for
+
+    static SampleRecord samples[MaxSamples];
+    struct Thread { DWORD tid; HANDLE handle; };
+    static Thread threads[MaxThreads];
+    uint32_t threadCount = 0;
+    uint32_t count = 0;
+    bool reportedFull = false;
+    DWORD lastWrite = ::GetTickCount();
+    DWORD lastScan  = lastWrite - ScanIntervalMs;
+
+    HMODULE self = nullptr;
+    ::GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+      reinterpret_cast<LPCSTR>(&SamplerMarker), &self);
+
+    uint32_t range[3][2] = { };   // [this DLL, client.dll, winevulkan.dll] x [base, end)
+    range[0][0] = uint32_t(uintptr_t(self));
+    range[0][1] = range[0][0] + GetModuleImageSize(self);
+
+    // Light mode (sample-light.flag): only the thread that presents and DXVK's own, at the longer interval.
+    // Pausing every thread at the short one makes the game's own memory writes far slower than they are.
+    const bool light = HasDiagnosticsFile("sample-light.flag");
+
+    const std::string modulesPath = GetMxoDiagnosticsPath("modules.txt");
+    const std::string samplesPath = GetMxoDiagnosticsPath("samples.bin");
+
+    for (;;) {
+      ::Sleep(light ? LightIntervalMs : IntervalMs);
+      const DWORD now = ::GetTickCount();
+
+      if (now - lastScan >= ScanIntervalMs) {
+        lastScan = now;
+
+        HMODULE client = ::GetModuleHandleA("client.dll");
+        HMODULE vulkan = ::GetModuleHandleA("winevulkan.dll");
+        range[1][0] = uint32_t(uintptr_t(client)); range[1][1] = range[1][0] + GetModuleImageSize(client);
+        range[2][0] = uint32_t(uintptr_t(vulkan)); range[2][1] = range[2][0] + GetModuleImageSize(vulkan);
+
+        HANDLE snapshot = ::CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+
+        if (snapshot != INVALID_HANDLE_VALUE) {
+          THREADENTRY32 entry = { };
+          entry.dwSize = sizeof(entry);
+
+          for (BOOL more = ::Thread32First(snapshot, &entry); more; more = ::Thread32Next(snapshot, &entry)) {
+            if (entry.th32OwnerProcessID != ::GetCurrentProcessId() || entry.th32ThreadID == ::GetCurrentThreadId())
+              continue;
+
+            bool known = false;
+
+            for (uint32_t i = 0; i < threadCount && !known; i++)
+              known = threads[i].tid == entry.th32ThreadID;
+
+            if (known || threadCount >= MaxThreads)
+              continue;
+
+            if (HANDLE handle = ::OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, entry.th32ThreadID))
+              threads[threadCount++] = { entry.th32ThreadID, handle };
+          }
+
+          ::CloseHandle(snapshot);
+        }
+
+        // Where every module sits (modules.txt, rewritten when the list changes), so that
+        // samples outside this DLL and client.dll can be named: "base size name", hex.
+        static uint32_t s_moduleSum = 0;
+        snapshot = ::CreateToolhelp32Snapshot(TH32CS_SNAPMODULE | TH32CS_SNAPMODULE32, 0);
+
+        if (snapshot != INVALID_HANDLE_VALUE) {
+          char text[16384];
+          size_t used = 0;
+          uint32_t sum = 0;
+          MODULEENTRY32 entry = { };
+          entry.dwSize = sizeof(entry);
+
+          for (BOOL more = ::Module32First(snapshot, &entry); more; more = ::Module32Next(snapshot, &entry)) {
+            sum = sum * 31 + uint32_t(uintptr_t(entry.modBaseAddr)) + entry.modBaseSize;
+            int n = std::snprintf(text + used, sizeof(text) - used, "%08x %08x %s\n",
+              unsigned(uintptr_t(entry.modBaseAddr)), unsigned(entry.modBaseSize), entry.szModule);
+            if (n > 0 && used + size_t(n) < sizeof(text))
+              used += size_t(n);
+          }
+
+          ::CloseHandle(snapshot);
+
+          if (sum != s_moduleSum) {
+            s_moduleSum = sum;
+            if (FILE* file = std::fopen(modulesPath.c_str(), "w")) {
+              std::fwrite(text, 1, used, file);
+              std::fclose(file);
+            }
+          }
+        }
+      }
+
+      // light mode: the presenting thread plus DXVK's own threads (render, submit, queue)
+      const env::ThreadNameEntry* lightNames = nullptr;
+      const uint32_t lightNameCount = light ? env::getThreadNames(&lightNames) : 0;
+
+      for (uint32_t i = 0; i < threadCount && count < MaxSamples; i++) {
+        if (light && threads[i].tid != s_presentThreadId) {
+          bool dxvkThread = false;
+          for (uint32_t k = 0; k < lightNameCount && !dxvkThread; k++)
+            dxvkThread = lightNames[k].tid == threads[i].tid && !std::strncmp(lightNames[k].name, "dxvk-", 5);
+          if (!dxvkThread)
+            continue;
+        }
+
+        if (::SuspendThread(threads[i].handle) == DWORD(-1))
+          continue;
+
+        CONTEXT context;
+        context.ContextFlags = CONTEXT_CONTROL;
+
+        if (::GetThreadContext(threads[i].handle, &context)) {
+          SampleRecord record = { threads[i].tid, uint32_t(context.Eip), { 0, 0, 0 }, { 0, 0, 0 }, 0 };
+          uint32_t clientCount = 0;
+          uint32_t selfCount = 0;
+          auto stack = reinterpret_cast<const uint32_t*>(uintptr_t(context.Esp));
+
+          if (context.Esp && !::IsBadReadPtr(stack, sizeof(uint32_t) * StackWords)) {
+            for (uint32_t k = 0; k < StackWords; k++) {
+              const uint32_t value = stack[k];
+
+              if (value >= range[0][0] + ModuleHeaderSize && value < range[0][1]) {
+                if (selfCount < std::size(record.retSelf) && FollowsCall(value)) record.retSelf[selfCount++] = value;
+              } else if (value >= range[1][0] + ModuleHeaderSize && value < range[1][1]) {
+                if (clientCount < std::size(record.retClient) && FollowsCall(value)) record.retClient[clientCount++] = value;
+              } else if (value >= range[2][0] + ModuleHeaderSize && value < range[2][1]) {
+                if (!record.retVulkan && FollowsCall(value)) record.retVulkan = value;
+              }
+            }
+          }
+
+          samples[count++] = record;
+        }
+
+        ::ResumeThread(threads[i].handle);
+      }
+
+      if (count == MaxSamples && !reportedFull) {
+        reportedFull = true;
+        Logger::info(str::format("MxO: the profiler holds ", MaxSamples, " samples between writes to its file, the rest of each interval is lost"));
+      }
+
+      if (now - lastWrite < WriteIntervalMs)
+        continue;
+
+      lastWrite = now;
+
+      if (FILE* file = std::fopen(samplesPath.c_str(), "ab")) {
+        const env::ThreadNameEntry* names = nullptr;
+        const uint32_t nameCount = env::getThreadNames(&names);
+        static constexpr uint32_t FileMagic = 0x34504d53u;   // "SMP4", the format profile2.py expects
+        const uint32_t head[] = { FileMagic, count, range[1][0], range[0][0], range[0][1] - range[0][0],
+          range[2][0], range[2][1] - range[2][0], uint32_t(s_presentThreadId), nameCount, 0 };
+        std::fwrite(head, sizeof(head[0]), std::size(head), file);
+        std::fwrite(names, sizeof(env::ThreadNameEntry), nameCount, file);
+        std::fwrite(samples, sizeof(SampleRecord), count, file);
+        std::fclose(file);
+      }
+
+      count = 0;
+    }
+  }
+
+  static void StartSamplerOnce() {
+    static const bool s_started = [] {
+      if (!HasDiagnosticsFile("sample.flag") && !HasDiagnosticsFile("sample-light.flag"))
+        return false;
+
+      s_presentThreadId = ::GetCurrentThreadId();
+
+      HANDLE thread = ::CreateThread(nullptr, 0, SamplerThreadProc, nullptr, 0, nullptr);
+
+      if (thread)
+        ::CloseHandle(thread);
+
+      return thread != nullptr;
+    }();
+    (void) s_started;
+  }
+
+
+  // Optional diagnostics, enabled by creating the file debug.flag in the diagnostics folder before the game starts:
+  //  - logs the number of presented frames at regular intervals, and every slow frame
+  //  - saves the back buffer to shot.bmp in that folder whenever shot.req appears there
+  static void DebugFrameTools(D3D9DeviceEx* device, IDirect3DSurface9* backBuffer) {
+    static constexpr uint64_t LogIntervalSeconds = 5;
+    static constexpr uint64_t RequestChecksPerSecond = 2;   // how often the request files are looked for
+    static constexpr uint64_t SpikeUs = 40000;              // a frame this slow gets a SPIKE line
+    static constexpr uint32_t MaxSpikeLines = 400;
+
+    static const bool s_enabled = HasDiagnosticsFile("debug.flag");
+
+    if (likely(!s_enabled))
+      return;
+
+    static uint64_t s_frames = 0, s_lastLog = 0, s_lastCheck = 0;
+
+    s_lastPresentMs = NowMs();
+    static const bool s_stallStarted = [] {
+      if (!s_presentThreadId)
+        s_presentThreadId = ::GetCurrentThreadId();
+      HANDLE t = ::CreateThread(nullptr, 0, StallThreadProc, nullptr, 0, nullptr);
+      if (t)
+        ::CloseHandle(t);
+      return t != nullptr;
+    }();
+    (void) s_stallStarted;
+
+    LARGE_INTEGER counter, frequency;
+    ::QueryPerformanceCounter(&counter);
+    ::QueryPerformanceFrequency(&frequency);
+
+    const uint64_t now = uint64_t(counter.QuadPart);
+    const uint64_t second = uint64_t(frequency.QuadPart);
+
+    s_frames += 1;
+
+    if (!s_lastLog)
+      s_lastLog = now;
+
+    // Spike lines: any slow frame, with what happened during it
+    {
+      static uint64_t s_prevPresent = 0;
+      static uint32_t s_spikes = 0;
+      static DxvkStatCounters s_prevFrame;
+      const DxvkStatCounters frameCounters = device->GetDXVKDevice()->getStatCounters();
+      const uint64_t frameUs = s_prevPresent ? (now - s_prevPresent) * 1000000 / second : 0;
+      s_prevPresent = now;
+
+      const bool spike = frameUs >= SpikeUs && s_spikes < MaxSpikeLines;
+      std::string what;
+
+      for (uint32_t i = 0; i < uint32_t(DxvkDebugCounter::Count); i++) {
+        const uint32_t n = DxvkDebugCounters::s_frame[i].exchange(0);
+        if (n && spike)
+          what += str::format(", ", DxvkDebugCounterNames[i], " ", n);
+      }
+
+      if (spike) {
+        auto d = [&] (DxvkStatCounter c) { return frameCounters.getCtr(c) - s_prevFrame.getCtr(c); };
+        Logger::info(str::format("SPIKE ", frameUs / 1000, " ms: draws ", d(DxvkStatCounter::CmdDrawCalls),
+          ", waits for render thread ", d(DxvkStatCounter::CsSyncCount), " = ", d(DxvkStatCounter::CsSyncTicks), " us",
+          ", waits for GPU ", d(DxvkStatCounter::GpuSyncCount), " = ", d(DxvkStatCounter::GpuSyncTicks), " us",
+          ", pipelines total ", frameCounters.getCtr(DxvkStatCounter::PipeCountGraphics), what));
+
+        if (++s_spikes == MaxSpikeLines)
+          Logger::info(str::format("SPIKE lines end here, ", MaxSpikeLines, " are logged"));
+      }
+
+      s_prevFrame = frameCounters;
+    }
+
+    if (now - s_lastLog >= LogIntervalSeconds * second) {
+      // what the graphics layer did per frame, and how long this thread sat waiting for it
+      static DxvkStatCounters s_lastCounters;
+      const DxvkStatCounters counters = device->GetDXVKDevice()->getStatCounters();
+      auto delta = [&] (DxvkStatCounter c) { return counters.getCtr(c) - s_lastCounters.getCtr(c); };
+      const uint64_t frames = std::max<uint64_t>(s_frames, 1);
+      const uint64_t spanUs = std::max<uint64_t>((now - s_lastLog) * 1000000 / second, 1);
+
+      const float throttle = GetMxoRenderThrottle();
+      Logger::info(str::format("FPS ", s_frames, " frames in ", (now - s_lastLog) * 1000 / second, " ms",
+        throttle >= 0.0f ? str::format(", render throttle ", int(throttle * 100.0f + 0.5f), "%") : std::string(),
+        "; per frame: draws ", delta(DxvkStatCounter::CmdDrawCalls) / frames,
+        ", render passes ", delta(DxvkStatCounter::CmdRenderPassCount) / frames,
+        ", submissions ", delta(DxvkStatCounter::QueueSubmitCount) * 10 / frames, "/10",
+        ", waits for render thread ", delta(DxvkStatCounter::CsSyncCount) * 10 / frames, "/10 = ", delta(DxvkStatCounter::CsSyncTicks) / frames, " us",
+        ", waits for GPU ", delta(DxvkStatCounter::GpuSyncCount) * 10 / frames, "/10 = ", delta(DxvkStatCounter::GpuSyncTicks) / frames, " us",
+        "; GPU idle ", delta(DxvkStatCounter::GpuIdleTicks) * 100 / spanUs, "%"));
+      s_lastCounters = counters;
+
+      // what the game asked for, and where render passes were broken up (callers by offset in this DLL)
+      std::string calls;
+
+      for (uint32_t i = 0; i < uint32_t(DxvkDebugCounter::Count); i++) {
+        const uint32_t n = DxvkDebugCounters::s_value[i].exchange(0);
+        if (n)
+          calls += str::format(" ", DxvkDebugCounterNames[i], " ", n * 10 / frames, "/10");
+      }
+
+      HMODULE self = nullptr;
+      ::GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+        reinterpret_cast<LPCSTR>(&SamplerMarker), &self);
+      std::string spills;
+
+      for (uint32_t i = 0; i < DxvkSpillStats::Max; i++) {
+        const uint32_t n = DxvkSpillStats::s_count[i].exchange(0);
+        if (n)
+          spills += str::format(" +", std::hex, DxvkSpillStats::s_caller[i].load() - uintptr_t(self), std::dec, ":", n * 10 / frames, "/10");
+      }
+
+      Logger::info(str::format("FRAME calls per frame:", calls, "; render pass breaks by caller:", spills));
+      s_frames  = 0;
+      s_lastLog = now;
+    }
+
+    // a frame draw log ends at the next Present
+    if (DxvkDrawLog::s_active.load() && DxvkDrawLog::s_active.fetch_sub(1) == 1)
+      Logger::info(str::format("DRAWLOG end: ", DxvkDrawLog::s_index.load(), " draws"));
+
+    if (now - s_lastCheck < second / RequestChecksPerSecond)
+      return;
+
+    s_lastCheck = now;
+
+    if (TakeDiagnosticsRequest("drawlog.req")) {
+      DxvkDrawLog::s_index = 0;
+      Logger::info("DRAWLOG begin");
+      DxvkDrawLog::s_active = 1;
+    }
+
+    if (!TakeDiagnosticsRequest("shot.req"))
+      return;
+
+    D3DSURFACE_DESC desc;
+
+    if (!backBuffer || FAILED(backBuffer->GetDesc(&desc)))
+      return;
+
+    // the copy below takes three of four bytes per pixel
+    static constexpr uint32_t SourceBytesPerPixel = 4;
+    static constexpr uint32_t BmpBytesPerPixel    = 3;
+
+    if (desc.Format != D3DFMT_X8R8G8B8 && desc.Format != D3DFMT_A8R8G8B8) {
+      Logger::warn(str::format("SHOT not saved: the back buffer has format ", uint32_t(desc.Format), ", which is not one with 8 bits per colour"));
+      return;
+    }
+
+    Com<IDirect3DSurface9> dst;
+    HRESULT hr = device->CreateOffscreenPlainSurface(desc.Width, desc.Height, desc.Format, D3DPOOL_SYSTEMMEM, &dst, nullptr);
+
+    if (SUCCEEDED(hr))
+      hr = device->GetRenderTargetData(backBuffer, dst.ptr());
+
+    D3DLOCKED_RECT lr = { };
+
+    if (SUCCEEDED(hr))
+      hr = dst->LockRect(&lr, nullptr, D3DLOCK_READONLY);
+
+    if (FAILED(hr)) {
+      Logger::warn(str::format("SHOT not saved: reading the back buffer failed, hr=0x", std::hex, uint32_t(hr)));
+      return;
+    }
+
+    // a BMP file: two headers, then the rows from the bottom up, each padded to four bytes
+    const uint32_t w = desc.Width, h = desc.Height;
+    const uint32_t stride = (w * BmpBytesPerPixel + 3) & ~3u;
+    const uint32_t size   = stride * h;
+
+    BITMAPFILEHEADER fileHeader = { };
+    BITMAPINFOHEADER infoHeader = { };
+    const uint32_t headerSize = sizeof(fileHeader) + sizeof(infoHeader);
+    static_assert(sizeof(fileHeader) + sizeof(infoHeader) == 54, "the two BMP headers are written as they are in memory");
+
+    fileHeader.bfType      = 0x4d42;   // "BM"
+    fileHeader.bfSize      = headerSize + size;
+    fileHeader.bfOffBits   = headerSize;
+    infoHeader.biSize      = sizeof(infoHeader);
+    infoHeader.biWidth     = LONG(w);
+    infoHeader.biHeight    = LONG(h);
+    infoHeader.biPlanes    = 1;
+    infoHeader.biBitCount  = 8 * BmpBytesPerPixel;
+    infoHeader.biSizeImage = size;
+
+    std::vector<uint8_t> out(headerSize + size, 0);
+    std::memcpy(out.data(), &fileHeader, sizeof(fileHeader));
+    std::memcpy(out.data() + sizeof(fileHeader), &infoHeader, sizeof(infoHeader));
+
+    for (uint32_t y = 0; y < h; y++) {
+      const uint8_t* src = reinterpret_cast<const uint8_t*>(lr.pBits) + size_t(lr.Pitch) * y;
+      uint8_t* row = out.data() + headerSize + size_t(stride) * (h - 1 - y);
+
+      for (uint32_t x = 0; x < w; x++)
+        std::memcpy(row + x * BmpBytesPerPixel, src + x * SourceBytesPerPixel, BmpBytesPerPixel);
+    }
+
+    dst->UnlockRect();
+
+    HANDLE f = ::CreateFileA(GetMxoDiagnosticsPath("shot.bmp").c_str(), GENERIC_WRITE, 0, nullptr,
+      CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    DWORD written = 0;
+    const bool saved = f != INVALID_HANDLE_VALUE
+      && ::WriteFile(f, out.data(), DWORD(out.size()), &written, nullptr)
+      && written == out.size();
+    const DWORD error = saved ? 0 : ::GetLastError();
+
+    if (f != INVALID_HANDLE_VALUE)
+      ::CloseHandle(f);
+
+    if (saved)
+      Logger::info(str::format("SHOT saved ", w, "x", h));
+    else
+      Logger::warn(str::format("SHOT not saved: shot.bmp could not be written, error ", error));
+  }
+
