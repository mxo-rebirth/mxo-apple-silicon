+  void D3D9DeviceEx::BindStaticSamplerVariants(uint32_t UsedTextureMask) {
+    auto bind = [this] (
+            uint32_t              slot,
+            VkShaderStageFlagBits stage,
+      const D3D9CommonShader*     shader,
+            D3D9ShaderPermutation permutation,
+            uint32_t              types,
+            uint32_t              depth) {
+      const uint64_t key = uint64_t(types) | (uint64_t(depth) << 32);
+
+      if (m_variantShader[slot] == shader && m_variantKey[slot] == key && m_variantPerm[slot] == permutation)
+        return;
+
+      m_variantShader[slot] = shader;
+      m_variantKey[slot]    = key;
+      m_variantPerm[slot]   = permutation;
+
+      EmitCs([
+        cStage  = stage,
+        cShader = shader->GetStaticSamplerVariant(this, permutation, types, depth)
+      ] (DxvkContext* ctx) {
+        ctx->bindShader(cStage, cShader);
+      });
+    };
+
+    const uint32_t psMask = UsedTextureMask &  ((1u << caps::MaxTexturesPS) - 1u);
+    const uint32_t vsMask = UsedTextureMask & ~((1u << (caps::MaxTexturesPS + 1)) - 1u);
+
+    if (UseProgrammablePS()) {
+      const D3D9CommonShader* shader = GetCommonShader(m_state.pixelShader);
+      const auto& info = shader->GetInfo();
+
+      // Only shader model 1 leaves the image type of a sampler to the bound texture
+      uint32_t types = 0;
+
+      if (info.majorVersion() < 2 || m_d3d9Options.forceSamplerTypeSpecConstants) {
+        for (uint32_t i = 0; i < caps::MaxTexturesPS; i++) {
+          if (psMask & (1u << i))
+            types |= m_textureTypes & (3u << (2 * i));
+        }
+      }
+
+      bind(1, VK_SHADER_STAGE_FRAGMENT_BIT, shader, GetPixelShaderPermutation(), types, m_depthTextures & psMask);
+    } else {
+      m_variantShader[1] = nullptr;
+    }
+
+    if (UseProgrammableVS()) {
+      bind(0, VK_SHADER_STAGE_VERTEX_BIT, GetCommonShader(m_state.vertexShader),
+        GetVertexShaderPermutation(), 0, m_depthTextures & vsMask);
+    } else {
+      m_variantShader[0] = nullptr;
+    }
   }
 
 
