+  // Some switches are read for every device. Each is reported in the log only the first time.
+  static bool isFirstReport(const char* name) {
+    static dxvk::mutex              s_mutex;
+    static std::vector<std::string> s_reported;
+
+    std::lock_guard<dxvk::mutex> lock(s_mutex);
+
+    if (std::find(s_reported.begin(), s_reported.end(), name) != s_reported.end())
+      return false;
+
+    s_reported.push_back(name);
+    return true;
+  }
+
+
+  EnvSwitch getEnvSwitch(const char* name) {
+    const std::string value = getEnvVar(name);
+
+    if (value == "0")
+      return EnvSwitch::Zero;
+
+    if (value == "1")
+      return EnvSwitch::One;
+
+    if (!value.empty() && isFirstReport(name))
+      Logger::warn(str::format("MxO: ", name, "=", value, " is not understood and has no effect, only 0 and 1 are"));
+
+    return EnvSwitch::Unset;
+  }
+
+
+  bool isFixEnabled(const char* name, EnvSwitch off) {
+    const bool enabled = getEnvSwitch(name) != off;
+
+    if (!enabled && isFirstReport(name))
+      Logger::info(str::format("MxO: ", name, "=", off == EnvSwitch::Zero ? "0" : "1", " is set, which is not the default"));
+
+    return enabled;
+  }
+
+
+  uint32_t getEnvSizeMB(const char* name, uint32_t defaultMB, uint32_t maxMB) {
+    // a number with more digits is above any limit, and need not fit the integer
+    constexpr size_t MaxDigits = 9;
+
+    const std::string value = getEnvVar(name);
+
+    if (value.empty())
+      return defaultMB;
+
+    // digits only: strtoul would accept a sign, and read "12abc" as 12
+    if (value.find_first_not_of("0123456789") != std::string::npos) {
+      if (isFirstReport(name))
+        Logger::warn(str::format("MxO: ", name, "=", value, " is not a number of megabytes, using ", defaultMB));
+
+      return defaultMB;
+    }
+
+    const uint32_t asked = value.size() > MaxDigits ? maxMB : uint32_t(std::strtoul(value.c_str(), nullptr, 10));
+    const uint32_t size  = std::min(asked, maxMB);
+
+    if (size != defaultMB && isFirstReport(name)) {
+      Logger::info(str::format("MxO: ", name, " is set to ", size, " MB, which is not the default",
+        size != asked || value.size() > MaxDigits ? " (and the most it takes)" : ""));
+    }
+
+    return size;
+  }
