+  "movsd   qword ptr [esp+4], xmm0\n"
+  "fld     qword ptr [esp+4]\n"
+  "add     esp, 12\n"
+  "ret\n"
+  "7:\n"
+  "add     esp, 12\n"
+  "8:\n"
