+  // Optional diagnostics, enabled by creating the file C:\Games\dxvk\debug.flag before the game starts:
+  //  - logs the number of presented frames every five seconds
+  //  - saves the back buffer to C:\Games\dxvk\shot.bmp whenever C:\Games\dxvk\shot.req appears
+  static void DebugFrameTools(D3D9DeviceEx* device, IDirect3DSurface9* backBuffer) {
+    static const bool s_enabled = ::GetFileAttributesA("C:\\Games\\dxvk\\debug.flag") != INVALID_FILE_ATTRIBUTES;
+
+    if (likely(!s_enabled))
+      return;
+
+    static uint64_t s_frames = 0, s_lastLog = 0, s_lastCheck = 0;
+
+    LARGE_INTEGER counter, frequency;
+    ::QueryPerformanceCounter(&counter);
+    ::QueryPerformanceFrequency(&frequency);
+
+    const uint64_t now = uint64_t(counter.QuadPart);
+    const uint64_t second = uint64_t(frequency.QuadPart);
+
+    s_frames += 1;
+
+    if (!s_lastLog)
+      s_lastLog = now;
+
+    if (now - s_lastLog >= 5 * second) {
+      // what the graphics layer did per frame, and how long this thread sat waiting for it
+      static DxvkStatCounters s_lastCounters;
+      const DxvkStatCounters counters = device->GetDXVKDevice()->getStatCounters();
+      auto delta = [&] (DxvkStatCounter c) { return counters.getCtr(c) - s_lastCounters.getCtr(c); };
+      const uint64_t frames = std::max<uint64_t>(s_frames, 1);
+      const uint64_t spanUs = std::max<uint64_t>((now - s_lastLog) * 1000000 / second, 1);
+
+      const float throttle = GetMxoRenderThrottle();
+      Logger::info(str::format("FPS ", s_frames, " frames in ", (now - s_lastLog) * 1000 / second, " ms",
+        throttle >= 0.0f ? str::format(", render throttle ", int(throttle * 100.0f + 0.5f), "%") : std::string(),
+        "; per frame: draws ", delta(DxvkStatCounter::CmdDrawCalls) / frames,
+        ", render passes ", delta(DxvkStatCounter::CmdRenderPassCount) / frames,
+        ", submissions ", delta(DxvkStatCounter::QueueSubmitCount) * 10 / frames, "/10",
+        ", waits for render thread ", delta(DxvkStatCounter::CsSyncCount) * 10 / frames, "/10 = ", delta(DxvkStatCounter::CsSyncTicks) / frames, " us",
+        ", waits for GPU ", delta(DxvkStatCounter::GpuSyncCount) * 10 / frames, "/10 = ", delta(DxvkStatCounter::GpuSyncTicks) / frames, " us",
+        "; GPU idle ", delta(DxvkStatCounter::GpuIdleTicks) * 100 / spanUs, "%"));
+      s_lastCounters = counters;
+
+      // what the game asked for, and where render passes were broken up (callers by offset in this DLL)
+      static const char* const names[] = { "SetRenderTarget", "Clear", "EndScene", "StretchRect", "texture locks",
+        "texture uploads", "buffer uploads", "buffer renames", "ColorFill", "GetRenderTargetData" };
+      std::string calls;
+
+      for (uint32_t i = 0; i < uint32_t(DxvkDebugCounter::Count); i++) {
+        const uint32_t n = DxvkDebugCounters::s_value[i].exchange(0);
+        if (n)
+          calls += str::format(" ", names[i], " ", n * 10 / frames, "/10");
+      }
+
+      HMODULE self = nullptr;
+      ::GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+        reinterpret_cast<LPCSTR>(&SamplerMarker), &self);
+      std::string spills;
+
+      for (uint32_t i = 0; i < DxvkSpillStats::Max; i++) {
+        const uint32_t n = DxvkSpillStats::s_count[i].exchange(0);
+        if (n)
+          spills += str::format(" +", std::hex, DxvkSpillStats::s_caller[i].load() - uintptr_t(self), std::dec, ":", n * 10 / frames, "/10");
+      }
+
+      Logger::info(str::format("FRAME calls per frame:", calls, "; render pass breaks by caller:", spills));
+      s_frames  = 0;
+      s_lastLog = now;
+    }
+
+    if (now - s_lastCheck < second / 2)
+      return;
+
+    s_lastCheck = now;
+
+    if (::GetFileAttributesA("C:\\Games\\dxvk\\shot.req") == INVALID_FILE_ATTRIBUTES)
+      return;
+
+    ::DeleteFileA("C:\\Games\\dxvk\\shot.req");
+
+    D3DSURFACE_DESC desc;
+
+    if (!backBuffer || FAILED(backBuffer->GetDesc(&desc)))
+      return;
+
+    Com<IDirect3DSurface9> dst;
+    HRESULT hr = device->CreateOffscreenPlainSurface(desc.Width, desc.Height, desc.Format, D3DPOOL_SYSTEMMEM, &dst, nullptr);
+
+    if (SUCCEEDED(hr))
+      hr = device->GetRenderTargetData(backBuffer, dst.ptr());
+
+    D3DLOCKED_RECT lr = { };
+
+    if (SUCCEEDED(hr))
+      hr = dst->LockRect(&lr, nullptr, D3DLOCK_READONLY);
+
+    if (FAILED(hr)) {
+      Logger::info(str::format("SHOT failed hr=0x", std::hex, uint32_t(hr)));
+      return;
+    }
+
+    const uint32_t w = desc.Width, h = desc.Height, stride = (w * 3 + 3) & ~3u, size = stride * h;
+    std::vector<uint8_t> out(54 + size, 0);
+    uint8_t* hd = out.data();
+    hd[0] = 'B'; hd[1] = 'M';
+    auto put32 = [&] (uint32_t off, uint32_t v) { std::memcpy(hd + off, &v, 4); };
+    put32(2, 54 + size); put32(10, 54); put32(14, 40); put32(18, w); put32(22, h);
+    hd[26] = 1; hd[28] = 24; put32(34, size);
+
+    for (uint32_t y = 0; y < h; y++) {
+      const uint8_t* src = reinterpret_cast<const uint8_t*>(lr.pBits) + size_t(lr.Pitch) * y;
+      uint8_t* row = hd + 54 + size_t(stride) * (h - 1 - y);
+      for (uint32_t x = 0; x < w; x++) { row[x * 3] = src[x * 4]; row[x * 3 + 1] = src[x * 4 + 1]; row[x * 3 + 2] = src[x * 4 + 2]; }
+    }
+
+    dst->UnlockRect();
+
+    HANDLE f = ::CreateFileA("C:\\Games\\dxvk\\shot.bmp", GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+
+    if (f != INVALID_HANDLE_VALUE) {
+      DWORD written = 0;
+      ::WriteFile(f, out.data(), DWORD(out.size()), &written, nullptr);
+      ::CloseHandle(f);
+    }
+
+    Logger::info(str::format("SHOT saved ", w, "x", h));
+  }
