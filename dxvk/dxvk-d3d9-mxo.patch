+++ b/src/dxvk/dxvk_debug_counters.h	2026-11-19 00:00:00
@@ -0,0 +1,91 @@
+#pragma once
+
+// Diagnostic counters read by the D3D9 front end's optional frame log (debug.flag).
+// Written from the rendering threads without locking. The values are statistics, not state.
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace dxvk {
+
+  /// Where render passes get interrupted: callers of DxvkContext::spillRenderPass that found a pass open
+  struct DxvkSpillStats {
+    static constexpr uint32_t Max = 24;
+
+    static inline std::atomic<uintptr_t> s_caller[Max] = { };
+    static inline std::atomic<uint32_t>  s_count[Max]  = { };
+
+    static void add(void* caller) {
+      const uintptr_t address = reinterpret_cast<uintptr_t>(caller);
+
+      for (uint32_t i = 0; i < Max; i++) {
+        uintptr_t current = s_caller[i].load();
+
+        if (!current) {
+          s_caller[i].compare_exchange_strong(current, address);
+          current = s_caller[i].load();
+        }
+
+        if (current == address) {
+          s_count[i]++;
+          return;
+        }
+      }
+    }
+  };
+
+  /// What the frame log counts: calls of the application, the work they led to, kilobytes and microseconds
+  enum class DxvkDebugCounter : uint32_t {
+    SetRenderTarget, Clear, EndScene, StretchRect,
+    TextureLock, TextureUpload, BufferUpload, BufferRename,
+    ColorFill, GetRenderTargetData,
+    SwvpConstUploads, SwvpConstVec4, HwConstUploads,
+    BufferAllocs, BufferClearKB, NewMappedKB, RenameCopyKB,
+    InitFillKB, InitFillUs, ClearUs,
+    PrefaultUs, PrefaultFailed,
+    PipelineBuilds, PipelineBuildUs,
+    Count
+  };
+
+  /// What the frame log calls each counter, in the order of the enum
+  inline constexpr const char* DxvkDebugCounterNames[] = {
+    "SetRenderTarget", "Clear", "EndScene", "StretchRect",
+    "texture locks", "texture uploads", "buffer uploads", "buffer renames",
+    "ColorFill", "GetRenderTargetData",
+    "SWVP constant uploads", "SWVP constant vec4s copied", "HW constant uploads",
+    "new buffers", "KB cleared", "KB new mapped memory", "KB copied by renames",
+    "KB zero-filled at creation", "us zero-filling", "us clearing",
+    "us prefaulting", "prefault failures",
+    "pipelines built at draw time", "us building pipelines",
+  };
+
+  static_assert(sizeof(DxvkDebugCounterNames) / sizeof(DxvkDebugCounterNames[0]) == uint32_t(DxvkDebugCounter::Count));
+
+  struct DxvkDebugCounters {
+    static inline std::atomic<uint32_t> s_value[uint32_t(DxvkDebugCounter::Count)] = { };
+    static inline std::atomic<uint32_t> s_frame[uint32_t(DxvkDebugCounter::Count)] = { };  // per frame, for spike lines
+    static void add(DxvkDebugCounter c) { s_value[uint32_t(c)]++; s_frame[uint32_t(c)]++; }
+    static void add(DxvkDebugCounter c, uint32_t n) { s_value[uint32_t(c)] += n; s_frame[uint32_t(c)] += n; }
+  };
+
+  /// One-frame draw log (debug.flag and drawlog.req): nonzero while active
+  struct DxvkDrawLog {
+    static inline std::atomic<uint32_t> s_active = { 0 };
+    static inline std::atomic<uint32_t> s_index  = { 0 };
+  };
+
+  /// Adds the microseconds between construction and destruction to a counter
+  struct DxvkDebugTimer {
+    DxvkDebugCounter counter;
+    std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+
+    explicit DxvkDebugTimer(DxvkDebugCounter c) : counter(c) { }
+
+    ~DxvkDebugTimer() {
+      DxvkDebugCounters::add(counter, uint32_t(std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now() - start).count()));
+    }
+  };
+
+}
