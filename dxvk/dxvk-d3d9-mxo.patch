+  // Executables that are not marked NX-compatible (most games from before ~2008) make Wine
+  // map all readable memory as executable. Under CrossOver on Apple Silicon the first write
+  // to each fresh page of such memory, once it is shared with Metal as a mapped Vulkan
+  // allocation, takes about 1.2 seconds. Having the kernel fault the pages in up front
+  // (lock, then unlock) avoids that. It costs a few milliseconds per allocation.
+  // Set DXVK_PREFAULT_MAPPED_MEMORY=0 to disable.
+  //
+  // The pages also stay locked: when macOS is short of memory it compresses or swaps out pages
+  // the game is not writing to at the moment, and the next write to such a page of GPU-shared
+  // memory again takes about a second. Locked pages are never compressed or swapped. They are
+  // released when the memory is freed. DXVK_LOCK_MAPPED_MEMORY=0 unlocks them right away instead.
+  static void PrefaultMappedMemory(void* ptr, VkDeviceSize size) {
+    // enough to see that locking fails, without a line for every allocation
+    static constexpr uint32_t MaxWarnings = 4;
+
+    static const bool s_enabled = env::isFixEnabled("DXVK_PREFAULT_MAPPED_MEMORY");
+    static const bool s_keepLocked = env::isFixEnabled("DXVK_LOCK_MAPPED_MEMORY");
+
+    if (!s_enabled || !ptr || !size)
+      return;
+
+    DxvkDebugTimer timer(DxvkDebugCounter::PrefaultUs);
+
+    if (::VirtualLock(ptr, SIZE_T(size))) {
+      if (!s_keepLocked)
+        ::VirtualUnlock(ptr, SIZE_T(size));
+    } else {
+      const DWORD error = ::GetLastError();
+      static std::atomic<uint32_t> s_warnings = { 0u };
+
+      DxvkDebugCounters::add(DxvkDebugCounter::PrefaultFailed);
+
+      if (s_warnings++ < MaxWarnings) {
+        Logger::warn(str::format("MxO: ", size >> 10, " KB of mapped memory could not be locked (error ", error,
+          "), the first write to each page of it will stall"));
+      }
+    }
+  }
